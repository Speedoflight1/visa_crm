<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Pipeline matches your actual workflow:
             New Lead -> Details Captured -> Follow Up Scheduled -> ID Received -->
        <record id="stage_new" model="crm.stage">
            <field name="name">New Lead</field>
            <field name="sequence">1</field>
            <field name="is_won">False</field>
        </record>

        <record id="stage_details_captured" model="crm.stage">
            <field name="name">Details Captured</field>
            <field name="sequence">2</field>
            <field name="is_won">False</field>
            <field name="fold">True</field>
        </record>

        <record id="stage_followup" model="crm.stage">
            <field name="name">Follow Up Scheduled</field>
            <field name="sequence">3</field>
            <field name="is_won">False</field>
            <field name="fold">True</field>
        </record>

        <record id="stage_id_received" model="crm.stage">
            <field name="name">ID Received</field>
            <field name="sequence">4</field>
            <field name="is_won">True</field>
            <field name="fold">True</field>
        </record>

    </data>
</odoo>
